# Salin ke .env lalu isi nilainya. Jangan commit .env.
PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# SMTP reset password. Untuk Gmail gunakan smtp.gmail.com + port 587 + App Password.
# Aktifkan 2-Step Verification Google sebelum membuat App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth. Daftarkan redirect URI: https://DOMAIN/api/auth/google/callback
APP_BASE_URL=https://domain-anda.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Variabel legacy OAuth tidak diperlukan untuk Google login.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
OWNER_OPEN_ID=
OWNER_NAME=
